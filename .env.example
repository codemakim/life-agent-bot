# BotFather에서 받은 Telegram bot token.
# 이전에 채팅/스크린샷 등에 노출된 토큰이면 BotFather에서 revoke/regenerate 후 새 값을 넣는다.
TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here

# 허용할 Telegram user id 목록.
# 여러 명이면 쉼표로 구분한다. 예: 123456789,987654321
# 처음에는 비워두고 ALLOW_ALL_USERS_DURING_SETUP=true로 실행한 뒤 /start 응답에서 확인한다.
ALLOWED_TELEGRAM_USER_ID=put_your_telegram_user_id_here

# 최초 user id 확인용 임시 모드.
# user id를 확인한 뒤에는 반드시 false로 바꾼다.
ALLOW_ALL_USERS_DURING_SETUP=false

# Ollama 서버 주소. 같은 WSL/PC에서 Ollama가 돌면 보통 이 값 그대로 쓴다.
OLLAMA_BASE_URL=http://localhost:11434

# 사용할 Ollama 모델 이름. `ollama list`에 보이는 이름과 맞아야 한다.
FAST_MODEL=gemma4:e4b
DEEP_MODEL=gemma4:26b
CODE_MODEL=gemma4:26b
VISION_MODEL=gemma4:e4b
